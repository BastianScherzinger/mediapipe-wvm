# ═══════════════════════════════════════════════════════════════════════════
#  MEDIAPIPE WVM — Konfiguration
#  Diese Datei als  .env  kopieren und die Zugänge eintragen.
#  Die .env gehört NIEMALS ins Repository (siehe .gitignore).
# ═══════════════════════════════════════════════════════════════════════════

# ── 1. Higgsfield ───────────────────────────────────────────────────────────
# API-Schlüssel von https://cloud.higgsfield.ai/api-keys im Format ID:SECRET.
# ACHTUNG: Ein Web-Abo (Soul/Plus) füllt diesen Topf NICHT — die Platform-API
# hat ein eigenes Guthaben. Ohne Guthaben antwortet sie mit 403.
HIGGSFIELD_API_KEY=

# ── 2. Claude ───────────────────────────────────────────────────────────────
# Optional. Wird nur gebraucht, wenn der API-Weg genutzt werden soll.
# Der Standardweg ist die Claude-CLI (Abo-Anmeldung, kein Guthaben nötig).
ANTHROPIC_KEY=

# Reihenfolge der Sprachmodell-Wege. Erster verfügbarer gewinnt.
#   cli   = Claude-CLI über Abo-Anmeldung   (empfohlen)
#   api   = Anthropic-API mit ANTHROPIC_KEY (braucht Guthaben)
#   local = Ollama auf diesem Rechner       (offline, kostenlos)
MPW_LLM_CHAIN=cli,api,local
MPW_CLAUDE_CLI_MODEL=sonnet
MPW_CLAUDE_API_MODEL=claude-sonnet-4-5-20250929

# Lokale KI als letzte Rückfallebene
MPW_LOCAL_MODEL=qwen2.5:7b
MPW_OLLAMA_URL=http://localhost:11434
# Fehlendes Modell beim ersten Bedarf automatisch laden (1 = ja)
MPW_LOCAL_AUTOPULL=1

# Reihenfolge der Videowege. Erster verfügbarer gewinnt.
#   platform = Platform-API mit HIGGSFIELD_API_KEY
#   abo      = Credits des Web-Abos über mcp.higgsfield.ai
#   demo     = Probelauf ohne Guthaben (erzeugt lokale Platzhalter-Clips)
# Der Abo-Weg muss hier NICHT stehen: Sobald er im Dashboard verbunden ist, rückt er
# von allein nach vorn. Wer ihn festschreiben will, darf ihn trotzdem eintragen.
MPW_VIDEO_CHAIN=platform,demo

# ── 3. Modelle ──────────────────────────────────────────────────────────────
# Nachweislich vorhandene Pfade — siehe docs/API_BEFUND.md
# Diese Namen gelten für die Platform-API. Läuft die Erzeugung über das Abo, übersetzt
# das Programm sie selbst in die Kennungen des MCP-Dienstes — hier ist nichts zu ändern.
MPW_IMAGE_MODEL=higgsfield-ai/soul/standard
MPW_VIDEO_MODEL=kling-video/v2.6/pro/image-to-video
MPW_T2V_MODEL=minimax/hailuo-02/standard/text-to-video

# ── 4. Programmfenster ──────────────────────────────────────────────────────
MPW_HOST=127.0.0.1
MPW_PORT=7788
# 1 = eigenes Desktop-Fenster, 0 = im Standardbrowser öffnen
MPW_WINDOW=1

# ── 5. Grenzen und Zeitlimits ───────────────────────────────────────────────
MPW_MAX_SCENES=12          # Obergrenze Szenen je Storyboard
MPW_HTTP_TIMEOUT=45        # Sekunden je Netzanfrage
MPW_JOB_TIMEOUT=900        # Sekunden je Higgsfield-Auftrag
MPW_POLL_INTERVAL=4        # Sekunden zwischen Statusabfragen
MPW_MAX_RETRIES=3          # Wiederholungen bei vorübergehenden Fehlern

# ── 6. ffmpeg ───────────────────────────────────────────────────────────────
# Leer lassen: erst System-ffmpeg, dann das mitgelieferte imageio-ffmpeg.
MPW_FFMPEG=
